<Window x:Class="DynamicIslandWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Dynamic Island" Height="650" Width="420"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        AllowDrop="True" 
        DragEnter="Window_DragEnter" 
        DragOver="Window_DragOver" 
        DragLeave="Window_DragLeave" 
        Drop="Window_Drop">
    <Grid Name="mainGrid" Background="Transparent">
        <!-- O hitTestBorder e o WebView2 agora ocupam apenas a área necessária -->
        <Border Name="hitTestBorder" 
                Background="#01000000" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Width="300" Height="44" 
                Margin="12,0,0,12" />
        
        <wv2:WebView2 Name="webView" 
                      DefaultBackgroundColor="Transparent"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Bottom" 
                      Width="300" Height="44" 
                      Margin="12,0,0,12" />
    </Grid>
</Window>