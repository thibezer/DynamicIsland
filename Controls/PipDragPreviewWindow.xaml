<Window x:Class="DynamicIslandWindows.Controls.PipDragPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260"
        Height="146"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        IsHitTestVisible="False"
        Focusable="False"
        ResizeMode="NoResize">
    <Border x:Name="previewCard"
            CornerRadius="14"
            BorderThickness="1.5"
            BorderBrush="#66FFFFFF"
            Background="#FF18181B"
            ClipToBounds="True"
            Opacity="0.94">
        <Grid>
            <!-- Capa do vídeo como fundo -->
            <Border x:Name="thumbBackdrop" Opacity="0.88" />

            <!-- Overlay para legibilidade do indicador -->
            <Border x:Name="dimOverlay" Background="#66000000" />

            <!-- Indicador central -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="19" Background="#88000000" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock x:Name="txtPipIcon"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="White"
                               Text="&#xE8A7;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Border Background="#99000000" CornerRadius="10" Padding="10,4" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtHint"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="Solte para abrir PiP aqui" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
